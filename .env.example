# ---------------------------------------------------------------------------
# ReliefChain environment. Copy to .env and fill in. Every integration is
# optional for a local demo: without keys the app uses a local JSON store,
# heuristic AI triage and SIMULATED PayPal calls (clearly labelled in the UI).
# ---------------------------------------------------------------------------

# PayPal REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox

# OpenAI — GPT-4o vulnerability scoring, photo analysis, fraud screening
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o

# Firebase service account (Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_client_email

PORT=3001

# Coordinator dashboard key (sent as x-admin-key). CHANGE THIS in any shared deploy.
ADMIN_API_KEY=reliefchain-demo-admin

# Comma-separated allowed browser origins, or * for any
CORS_ORIGIN=*

# Disbursement rules
PAYOUT_SCORE_THRESHOLD=70
MIN_PAYOUT_USD=10
MAX_PAYOUT_USD=150
# Starting pool balance in local demo mode only (ignored with Firestore)
DEMO_SEED_POOL_USD=500

# Optional: pre-fills the payout email on the report form (use a sandbox personal account)
VITE_DEMO_RECIPIENT_EMAIL=
